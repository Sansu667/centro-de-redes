# Copia este archivo como .env.local para trabajar en tu computador.
# En Vercel, estas mismas variables se crean en Settings → Environment Variables.

# Base de datos Postgres (Vercel la crea sola al conectar Neon desde la pestaña Storage)
DATABASE_URL=

# Clave para cifrar tokens de redes y secretos 2FA. Genérala UNA vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la cambias o la pierdes, habrá que reconectar las redes y reconfigurar el 2FA de todos.
ENCRYPTION_KEY=

# Código para crear el primer administrador en /configuracion-inicial (mínimo 16 caracteres).
# Después de crear el administrador puedes borrarlo.
SETUP_TOKEN=

# Secreto que Vercel usa para llamar a las tareas automáticas (mínimo 16 caracteres)
CRON_SECRET=

# Dirección pública de la app (en Vercel se toma sola; ponla si usas un dominio propio)
APP_URL=

# Archivos grandes y videos (Vercel lo crea solo al conectar Blob desde la pestaña Storage)
BLOB_READ_WRITE_TOKEN=

# --- Credenciales de cada red (se llenan cuando el Departamento registre sus apps) ---
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Opcionales
# META_GRAPH_VERSION=v24.0
# LINKEDIN_API_VERSION=202509
# Solo para pruebas locales por http (nunca en producción):
# COOKIE_INSEGURA=1
